# Values for a real Azure Entra ID deployment. Copy to .env (git-ignored) and
# fill in. The integration test with the simulated Entra ID does not need these.
AZURE_TENANT_ID=changeme
AZURE_CLIENT_ID=changeme
AZURE_CLIENT_SECRET=changeme
# Multiple groups may be separated by commas or newlines.
OIDC_GROUP_NAME=changeme
OIDC_ADMIN_GROUP_NAME=changeme
# Optional: MLflow's AI Gateway / judge endpoint selectors pre-select this model.
# Accepts "gateway:/<endpoint>", a bare "<endpoint>", or "<provider>:/<model>".
# MLFLOW_GENAI_JUDGE_DEFAULT_MODEL=gateway:/my-endpoint

# Optional: seed a default AI Gateway endpoint at startup (provider-agnostic).
# When set, the server creates (once) a model definition for MODEL and a gateway
# endpoint named by MLFLOW_GATEWAY_DEFAULT_ENDPOINT (or derived from
# MLFLOW_GENAI_JUDGE_DEFAULT_MODEL). Existing records are left untouched.
#
# PREFERRED: reference an existing gateway secret by name, so no credential
# material ever appears in configuration. Create the secret once (MLflow UI >
# AI Gateway > Secrets, or an admin job), then:
# MLFLOW_GATEWAY_DEFAULT_PROVIDER=anthropic
# MLFLOW_GATEWAY_DEFAULT_MODEL=claude-sonnet-4-5
# MLFLOW_GATEWAY_DEFAULT_SECRET_NAME=corp-anthropic-key
# MLFLOW_GATEWAY_DEFAULT_ENDPOINT=corp-judge
#
# DEV ONLY: create the secret from inline values. Each field is a separate env var
# (plain scalar, no JSON), so each can come from a Kubernetes Secret key:
#   MLFLOW_GATEWAY_DEFAULT_SECRET_<FIELD>       -> secret value field
#   MLFLOW_GATEWAY_DEFAULT_AUTH_CONFIG_<FIELD>  -> auth_config field
# <FIELD> is matched case-insensitively (API_KEY -> api_key). Per-provider fields:
#   openai     SECRET_API_KEY=sk-...            AUTH_CONFIG_API_BASE=https://...
#   anthropic  SECRET_API_KEY=sk-ant-...        AUTH_CONFIG_API_BASE=https://api.anthropic.com
#   gemini     SECRET_API_KEY=...
#   bedrock    SECRET_AWS_ACCESS_KEY_ID=...  SECRET_AWS_SECRET_ACCESS_KEY=...
#              AUTH_CONFIG_AUTH_MODE=access_keys  AUTH_CONFIG_AWS_REGION_NAME=us-east-1
#   azure      SECRET_API_KEY=...  AUTH_CONFIG_API_BASE=https://<res>.openai.azure.com  AUTH_CONFIG_API_VERSION=...
# MLFLOW_GATEWAY_DEFAULT_SECRET_API_KEY=sk-ant-...
# MLFLOW_GATEWAY_DEFAULT_AUTH_CONFIG_API_BASE=https://api.anthropic.com

# Databricks shorthand. Create the secret via DATABRICKS_CLIENT_ID/SECRET, or add
# MLFLOW_GATEWAY_DEFAULT_SECRET_NAME to reuse an existing secret instead.
# DATABRICKS_HOST=https://adb-<workspace-id>.<region>.azuredatabricks.net
# DATABRICKS_CLIENT_ID=changeme
# DATABRICKS_CLIENT_SECRET=changeme
# DATABRICKS_MODEL=databricks-claude-sonnet-4
# Optional: cache successful access-token (HTTP basic) verifications so polling
# pods/CI do not pay a DB lookup + hash check per request. Seconds; 0 disables.
# OIDC_BASIC_AUTH_CACHE_TTL_SECONDS=30
# OIDC_BASIC_AUTH_CACHE_MAX_SIZE=4096
# Concurrent first-time verifications per process (default 1).
# OIDC_BASIC_AUTH_WORKERS=1
